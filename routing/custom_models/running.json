{
  "_comment": [
    "Running profile. Statements are evaluated top to bottom and their",
    "multipliers COMPOUND, so the max_speed rules layer on top of road_class.",
    "",
    "Sidewalk presence is deliberately NOT handled here: GraphHopper cannot read",
    "OSM sidewalk=* without a Java patch. The safety half of that requirement is",
    "covered by road_class + max_speed below, which are built in. The preference",
    "half is applied as a ranking signal in api/src/scoring.ts."
  ],

  "priority": [
    { "if": "road_class == MOTORWAY",        "multiply_by": "0" },
    { "if": "road_class == TRUNK",           "multiply_by": "0" },
    { "if": "road_environment == FERRY",     "multiply_by": "0" },
    { "if": "road_access == PRIVATE",        "multiply_by": "0" },
    { "if": "road_access == NO",             "multiply_by": "0" },

    { "else_if": "road_class == FOOTWAY",    "multiply_by": "1.6" },
    { "else_if": "road_class == PEDESTRIAN", "multiply_by": "1.5" },
    { "else_if": "road_class == PATH",       "multiply_by": "1.4" },
    { "else_if": "road_class == TRACK",      "multiply_by": "1.1" },
    { "else_if": "road_class == RESIDENTIAL","multiply_by": "1.2" },
    { "else_if": "road_class == LIVING_STREET", "multiply_by": "1.25" },
    { "else_if": "road_class == SERVICE",    "multiply_by": "0.8" },
    { "else_if": "road_class == UNCLASSIFIED", "multiply_by": "0.9" },
    { "else_if": "road_class == TERTIARY",   "multiply_by": "0.55" },
    { "else_if": "road_class == SECONDARY",  "multiply_by": "0.3" },
    { "else_if": "road_class == PRIMARY",    "multiply_by": "0.12" },

    { "if": "road_class_link",               "multiply_by": "0.25" },

    { "if": "max_speed > 30",                "multiply_by": "0.5" },
    { "if": "max_speed > 40",                "multiply_by": "0.2" },
    { "if": "max_speed > 50",                "multiply_by": "0.05" },

    { "if": "road_class == STEPS",           "multiply_by": "0.15" },

    { "if": "surface == SAND",               "multiply_by": "0.4" },
    { "if": "surface == MUD",                "multiply_by": "0.3" },

    { "if": "hike_rating > 1",               "multiply_by": "0.3" }
  ],

  "speed": [
    { "if": "true", "limit_to": "6" }
  ]
}
